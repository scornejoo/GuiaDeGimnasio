<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:text="Power Fit Center"
        android:textColor="@color/texto"
        android:textSize="24sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/tvDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripcion"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        />

    <TextView
        android:id="@+id/tvHorario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Horario"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        />

    <TextView
        android:id="@+id/tvDireccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Direccion"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        />

    <TextView
        android:id="@+id/tvTelefono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Telefono"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        />

    <TextView
        android:id="@+id/tvCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Correo"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:layout_marginBottom="12dp"
        />

    <TextView
        android:id="@+id/tvWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sitio Web"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"
        />

    <Button
        android:id="@+id/btnMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍Ver en Mapa"
        android:textStyle="bold"
        android:textColor="@color/texto"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        />

    <Button
        android:id="@+id/btnWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="💻 Abrir en sitio web"
        android:textColor="@color/texto"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        />

    <Button
        android:id="@+id/btnLlamar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞 Llamar"
        android:textStyle="bold"
        android:textColor="@color/texto"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        />

    <Button
        android:id="@+id/btnCorreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✉️ Enviar correo"
        android:textStyle="bold"
        android:textColor="@color/texto"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        />

    <Button
        android:id="@+id/btnInscribirme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖊️ Inscribirme"
        android:textStyle="bold"
        android:textColor="@color/texto"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        />












</LinearLayout>